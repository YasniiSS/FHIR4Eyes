       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Corrected Intraocular Pressure" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Represents an intraocular pressure reading corrected for corneal thickness\r\n(pachymetry). Recorded as a separate Observation from the plain IOP reading, referencing\r\nboth the IOP and pachymetry measurements it was derived from via derivedFrom." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
