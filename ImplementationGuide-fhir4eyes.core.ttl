       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://YasniiSS.github.io/fhir4eyes/StructureDefinition/ophthalmic-encounter> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/ophthalmic-encounter" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Ophthalmic Encounter" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "An ambulatory ophthalmology consultation encounter. Parented on the generic\r\nFHIR Encounter, not the Chilean core Encounter profile (EncounterCL); the Chilean\r\ndependency belongs in the FHIR4Eyes CL extension, not this Core guide." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
