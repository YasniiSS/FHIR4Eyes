       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Ophthalmic Specular Microscopy" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Represents a corneal endothelial specular microscopy exam. Sourced directly\nfrom the FHIR4Eyes Observations catalog (Specular Microscopy section)." ] ;
