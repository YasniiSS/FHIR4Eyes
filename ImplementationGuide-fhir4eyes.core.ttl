         fhir:Reference.reference [ fhir:value "StructureDefinition/hirschberg-test" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Hirschberg Test" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Represents a Hirschberg corneal light reflex test, used to estimate the\r\nangle of deviation when other tests aren't feasible (e.g. young children). Performed across\r\nmultiple gaze positions; each position is recorded as a separate GazePositionMeasurement,\r\nreferenced here via hasMember, using its qualitative finding component." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
