     fhir:index 222 ;
     fhir:CodeSystem.concept.code [ fhir:value "false-negative-errors" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "False negative errors" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Percentage of false negative responses (no response to a supra-threshold stimulus at a previously seen location); a reliability index of the visual field test." ]
  ], [
     fhir:index 223 ;
     fhir:CodeSystem.concept.code [ fhir:value "test-distance-category" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Testing distance category (near/far)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Categorical testing distance (near or far) at which a strabismus or binocular vision test was performed. Answer is a CodeableConcept (near / far). Distinct from test-distance, which records the testing distance as a Quantity." ]
  ], [
     fhir:index 224 ;
     fhir:CodeSystem.concept.code [ fhir:value "near" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Near" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Near testing distance, approximately 33-40 cm." ]
  ], [
     fhir:index 225 ;
     fhir:CodeSystem.concept.code [ fhir:value "far" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Far" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Far (distance) testing distance, approximately 6 m (20 ft)." ]
  ], [
     fhir:index 226 ;
     fhir:CodeSystem.concept.code [ fhir:value "horizontal-deviation-direction" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Horizontal deviation direction" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Direction of the horizontal ocular deviation at a gaze position (esodeviation, exodeviation, or orthophoria when no horizontal deviation is present). The magnitude is recorded separately as a positive value in horizontal-deviation." ]
  ], [
     fhir:index 227 ;
     fhir:CodeSystem.concept.code [ fhir:value "vertical-deviation-direction" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Vertical deviation direction" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Direction of the vertical ocular deviation of the deviating eye at a gaze position (hyperdeviation or hypodeviation). The magnitude is recorded separately as a positive value in vertical-deviation." ]
  ], [
     fhir:index 228 ;
     fhir:CodeSystem.concept.code [ fhir:value "esodeviation" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Esodeviation" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Inward (nasal) horizontal deviation of the eye; covers esotropia and esophoria." ]
  ], [
     fhir:index 229 ;
     fhir:CodeSystem.concept.code [ fhir:value "exodeviation" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Exodeviation" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Outward (temporal) horizontal deviation of the eye; covers exotropia and exophoria." ]
  ], [
     fhir:index 230 ;
     fhir:CodeSystem.concept.code [ fhir:value "orthophoria" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Orthophoria" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Absence of any manifest or latent ocular deviation; the visual axes remain aligned under cover testing." ]
  ], [
     fhir:index 231 ;
     fhir:CodeSystem.concept.code [ fhir:value "hyperdeviation" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Hyperdeviation" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Upward vertical deviation of the deviating eye relative to the fellow eye; covers hypertropia and hyperphoria." ]
  ], [
     fhir:index 232 ;
     fhir:CodeSystem.concept.code [ fhir:value "hypodeviation" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Hypodeviation" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Downward vertical deviation of the deviating eye relative to the fellow eye; covers hypotropia and hypophoria." ]
  ], [
     fhir:index 233 ;
     fhir:CodeSystem.concept.code [ fhir:value "fusion" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Fusion" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Sensory fusion: the images of both eyes are combined into a single percept (e.g. a single pinkish light on the red filter plus light test, four lights on the Worth 4 dot test). SNOMED CT 78513008 Fusion binocular vision is an observable entity, not a finding, so it is not used as an answer." ]
  ], [
     fhir:index 234 ;
     fhir:CodeSystem.concept.code [ fhir:value "corneal-reflex-centered" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Corneal light reflex centered" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "On corneal light reflex (Hirschberg) testing, the reflex is centered on the pupil of the eye assessed, consistent with no manifest deviation of that eye." ]
  ], [
     fhir:index 235 ;
     fhir:CodeSystem.concept.code [ fhir:value "corneal-reflex-displaced-nasal" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Corneal light reflex displaced nasally" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "On corneal light reflex (Hirschberg) testing, the reflex in the eye assessed is displaced nasally from the pupil centre, indicating an exodeviation of that eye." ]
  ], [
     fhir:index 236 ;
     fhir:CodeSystem.concept.code [ fhir:value "corneal-reflex-displaced-temporal" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Corneal light reflex displaced temporally" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "On corneal light reflex (Hirschberg) testing, the reflex in the eye assessed is displaced temporally from the pupil centre, indicating an esodeviation of that eye." ]
  ], [
     fhir:index 237 ;
     fhir:CodeSystem.concept.code [ fhir:value "corneal-reflex-displaced-superior" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Corneal light reflex displaced superiorly" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "On corneal light reflex (Hirschberg) testing, the reflex in the eye assessed is displaced superiorly from the pupil centre, indicating a hypodeviation of that eye." ]
  ], [
     fhir:index 238 ;
     fhir:CodeSystem.concept.code [ fhir:value "corneal-reflex-displaced-inferior" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Corneal light reflex displaced inferiorly" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "On corneal light reflex (Hirschberg) testing, the reflex in the eye assessed is displaced inferiorly from the pupil centre, indicating a hyperdeviation of that eye." ]
  ] .

